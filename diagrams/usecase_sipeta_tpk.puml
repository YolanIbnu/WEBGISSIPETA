@startuml usecase_sipeta_tpk
left to right direction
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #FAF0DC
  BorderColor #C4A882
  FontSize 11
}
skinparam actor {
  FontSize 12
  FontStyle bold
}

title USE CASE DIAGRAM\nSIPETA TPK - Sistem Informasi Peta Tempat Penimbunan Kayu

actor "ADMIN" as admin
actor "STAFF" as staff
actor "SUPABASE\nSYSTEM" as supabase

rectangle "SISTEM SIPETA TPK" {

  usecase "LOGIN" as UC01
  usecase "LOGOUT" as UC02

  usecase "MELIHAT\nDASHBOARD" as UC03
  usecase "MELIHAT PETA\nINVENTORI" as UC04
  usecase "MELIHAT DETAIL\nBLOK KAYU" as UC05

  usecase "MENGEDIT DATA\nSTOK KAYU" as UC06
  usecase "MELIHAT DATA\nSTOK KAYU" as UC07
  usecase "MELIHAT RIWAYAT\nSTOK KAYU" as UC08

  usecase "MELIHAT LAPORAN\nBULANAN" as UC09
  usecase "EXPORT LAPORAN\nKE EXCEL" as UC10

  usecase "MENGELOLA\nPENGATURAN SISTEM" as UC11
  usecase "MENGELOLA\nAKUN PENGGUNA" as UC12

  usecase "MENERIMA UPDATE\nREALTIME" as UC13
}

' === ADMIN CONNECTIONS ===
admin --> UC01
admin --> UC02
admin --> UC03
admin --> UC04
admin --> UC05
admin --> UC06
admin --> UC07
admin --> UC08
admin --> UC09
admin --> UC10
admin --> UC11
admin --> UC12
admin --> UC13

' === STAFF CONNECTIONS ===
staff --> UC01
staff --> UC02
staff --> UC03
staff --> UC04
staff --> UC05
staff --> UC07
staff --> UC08
staff --> UC09
staff --> UC10
staff --> UC13

' === SUPABASE CONNECTIONS ===
supabase --> UC01
supabase --> UC06
supabase --> UC13

' === INCLUDE RELATIONS ===
UC04 ..> UC05 : <<include>>
UC05 ..> UC06 : <<include>>
UC09 ..> UC08 : <<include>>

' === EXTEND RELATIONS ===
UC10 ..> UC09 : <<extend>>
UC06 ..> UC13 : <<extend>>

@enduml
